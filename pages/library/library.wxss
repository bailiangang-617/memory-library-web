.library {
  padding-bottom: 180rpx;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.manage {
  padding-top: 10rpx;
  color: var(--accent);
  font-size: 26rpx;
}

.month {
  margin: 28rpx 0 12rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.batch {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
}

.batch .btn {
  flex: 1;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(42, 36, 28, 0.28);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sheet {
  width: 100%;
  max-height: 70vh;
  overflow: auto;
  background: var(--surface);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.sheet-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.sheet-empty {
  padding: 32rpx 0;
  color: var(--muted);
  font-size: 24rpx;
}
