.stats {
  display: flex;
  gap: 16rpx;
  margin: 32rpx 0 24rpx;
}

.stat {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
}

.num {
  font-size: 40rpx;
  font-weight: 600;
}

.label {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.block {
  padding: 28rpx 28rpx 12rpx;
  margin-bottom: 20rpx;
}

.block-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.line {
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
  font-size: 24rpx;
}

.muted {
  color: var(--muted);
}

.danger {
  margin-top: 16rpx;
}
