<view class="page">
  <view class="page-title">{{productName}}</view>
  <view class="page-sub">{{promise}}</view>

  <view class="stats">
    <view class="stat card">
      <view class="num">{{stats.photoCount}}</view>
      <view class="label">影像</view>
    </view>
    <view class="stat card">
      <view class="num">{{stats.memoryCount}}</view>
      <view class="label">纪念</view>
    </view>
    <view class="stat card">
      <view class="num">{{stats.tagCount}}</view>
      <view class="label">标签</view>
    </view>
  </view>

  <view class="card block">
    <view class="block-title">第一期可以做</view>
    <view wx:for="{{can}}" wx:key="*this" class="line">{{item}}</view>
  </view>

  <view class="card block">
    <view class="block-title">第一期不做</view>
    <view wx:for="{{cannot}}" wx:key="*this" class="line muted">{{item}}</view>
  </view>

  <view class="btn btn-ghost" bindtap="goImport">记下新的点滴</view>
  <view class="btn btn-danger danger" bindtap="clearAll">清空本机故事</view>
</view>
