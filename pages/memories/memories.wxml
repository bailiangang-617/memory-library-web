<view class="page">
  <view class="head">
    <view>
      <view class="page-title">回忆集</view>
      <view class="page-sub">把一段日子收成一集，而不是停在时间轴里</view>
    </view>
    <view wx:if="{{memories.length}}" class="manage" bindtap="createMemory">新建</view>
  </view>

  <empty-state
    wx:if="{{!memories.length}}"
    title="还没有回忆集"
    desc="{{photoCount ? '从照片库里挑一组照片，加个标题就能成集。' : '先导入一批照片，再把它们收成回忆集。'}}"
    action="{{photoCount ? '创建回忆集' : '去导入'}}"
    bind:action="onEmptyAction"
  />

  <view
    wx:for="{{memories}}"
    wx:key="id"
    class="card memory"
    data-id="{{item.id}}"
    bindtap="openMemory"
  >
    <image
      wx:if="{{item.cover && item.cover.filePath}}"
      class="cover"
      src="{{item.cover.filePath}}"
      mode="aspectFill"
    />
    <view wx:else class="cover blank"></view>
    <view class="meta">
      <view class="title">{{item.title}}</view>
      <view class="desc">{{item.photoCount}} 张{{item.rangeLabel ? ' · ' + item.rangeLabel : ''}}</view>
    </view>
  </view>
</view>
